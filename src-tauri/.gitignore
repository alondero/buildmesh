# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# ts-rs default export dir (issue #359). The canonical generated TS
# lives at `src/types/generated/` and is committed; this is the
# ts-rs default the `export_bindings_*` tests also write to when
# the TS_RS_EXPORT_DIR env var isn't picked up. Keep only the
# canonical copy under version control.
/bindings

# Updater signing keys must NEVER be committed — the private key lives
# only in the maintainer's ~/.tauri/ and in the TAURI_SIGNING_PRIVATE_KEY
# GitHub Actions secret. This is a defensive net (issue #826).
*.key
