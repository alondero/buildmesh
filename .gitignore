# Test artifacts
test-results/

.playwright-cli/

# Stray review/diff artifacts from agent sessions (e.g. `git diff > /tmp/x.patch`
# landing in worktree root on git-bash Windows). Real patch files committed to
# the repo should live in docs/ or similar — pattern is anchored to root only.
/review-diff.patch
/review_diff.patch
/*.patch.tmp
/diff.tmp
# Scratch directory for one-off agent session artifacts (e.g. body-file
# passed to `gh issue create`). Anything worth keeping should move out of
# `.tmp/` and into `docs/` before commit.
.tmp/
# Wayfinder working-draft mirrors (per-map resolution transcripts, map-body
# drafts). Never intended to ship — the canonical artifacts are the issue
# comments and the map's body on GitHub. Mirrors stay local for the session
# that produced them and serve as breadcrumbs if anyone pings the issue
# later. See CLAUDE.local.md for the per-map layout convention.
.wayfinder/
# Scratch diff files from code-review agents (e.g. /tmp/real_diff.txt saved
# into the worktree to coordinate with subagents). Never intended to ship.
/real_diff.txt
/.claude/real_diff.txt
# Stray diff snapshots dropped in the worktree root by some session tooling
# (e.g. `.tmp-github-diff.txt`, `.tmp-test-diff.txt`). Ephemeral and never
# intended to ship.
.tmp-*.txt
# Superpowers workflow artifacts (plans/, specs/) — session-only output of
# the Superpowers plugin that drove a single refactor each. The canonical
# record is the resulting commit/issue; the plan/spec files are breadcrumbs
# that outlived their purpose. See git history for the design-system,
# worktree-resume, and remote-access plans that lived here.
docs/superpowers/

# Claude worktrees and local settings (local only)
.claude/worktrees/
.claude/settings.local.json
.claude/tasks/
.claude/memory/
.claude/scheduled_tasks.lock
.antigravitycli/*.json
CLAUDE.local.md
coverage/
coverage/
.worktrees/
# Git-bash / Cygwin crash dumps (sh.exe.stackdump, bash.exe.stackdump, …)
*.stackdump
# Stray hand-compiled test binaries left at the repo root (e.g. the sandbox
# spike's test_user_buf.exe). Build output belongs under target/, never here.
/*.exe
/*.pdb
.altitude-findings.json

# diagnostic scratch files dropped by ad-hoc Bash commands
full_diff.txt
