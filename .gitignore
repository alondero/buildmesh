# Stray review/diff artifacts from agent sessions (e.g. `git diff > /tmp/x.patch`
# landing in worktree root on git-bash Windows). Real patch files committed to
# the repo should live in docs/ or similar — pattern is anchored to root only.
/review-diff.patch
/*.patch.tmp
/diff.tmp
# Scratch diff files from code-review agents (e.g. /tmp/real_diff.txt saved
# into the worktree to coordinate with subagents). Never intended to ship.
/real_diff.txt
/.claude/real_diff.txt

# Claude worktrees and local settings (local only)
.claude/worktrees/
.claude/settings.local.json
.claude/tasks/
.claude/memory/
.claude/scheduled_tasks.lock
.antigravitycli/*.json
CLAUDE.local.md
coverage/
coverage/
.worktrees/
# Git-bash / Cygwin crash dumps (sh.exe.stackdump, bash.exe.stackdump, …)
*.stackdump
# Stray hand-compiled test binaries left at the repo root (e.g. the sandbox
# spike's test_user_buf.exe). Build output belongs under target/, never here.
/*.exe
/*.pdb
