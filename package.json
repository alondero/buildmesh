{
  "name": "app",
  "private": true,
  "version": "1.5.0-0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:bg": "node scripts/dev-server.mjs start",
    "dev:stop": "node scripts/dev-server.mjs stop",
    "build": "tsc && vite build && vite build --mode mobile",
    "build:mobile": "vite build --mode mobile",
    "build:android-terminal": "vite build --config android/terminal/vite.config.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "version:set": "node scripts/set-version.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "brand:build": "node scripts/generate-brand-assets.mjs",
    "tauri:build:dev": "tauri build --config src-tauri/tauri.dev.conf.json --features dev-tools",
    "tauri:build:dev:codex-hook-smoke": "tauri build --config src-tauri/tauri.dev.conf.json --config scripts/tauri.codex-hook-smoke.conf.json --no-bundle --features dev-tools",
    "smoke:codex-hook-recovery": "node scripts/codex-hook-recovery-smoke.mjs",
    "test": "vitest run",
    "harness": "node scripts/harness.mjs",
    "verify": "node scripts/harness.mjs verify",
    "eval:harness": "node --test tests/agent-infra/harness.test.mjs tests/agent-infra/android-checks.test.mjs",
    "eval:behaviour": "node scripts/harness.mjs evaluate",
    "check:agent": "node scripts/check-agent-diff.mjs",
    "check:eol": "node scripts/check-line-endings.mjs",
    "self-review": "node scripts/self-review.mjs",
    "check:readme": "node scripts/check-readme-drift.mjs",
    "check:rust-shards": "node scripts/check-rust-shard-coverage.mjs",
    "check:actions": "node scripts/check-action-pins.mjs --verify",
    "check:audit": "node scripts/check-npm-audit.mjs",
    "check:audit:prod": "node scripts/check-npm-audit.mjs --omit=dev",
    "check:audit:rust": "node scripts/check-rust-advisories.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs --dist dist",
    "check:bundle-composition": "node scripts/check-bundle-composition.mjs --dist dist",
    "check:versions": "node scripts/check-manifest-versions.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fixtures": "node scripts/check-eslint-fixtures.mjs",
    "test:agent": "node --test tests/agent-infra/dev-launch.test.mjs tests/agent-infra/check-agent-diff.test.mjs tests/agent-infra/check-line-endings.test.mjs tests/agent-infra/check-manifest-versions.test.mjs tests/agent-infra/codex-hook-relay.test.mjs tests/agent-infra/check-process-spawn-discipline.test.mjs tests/agent-infra/run-guarded.test.mjs tests/agent-infra/retry-failed-runs.test.mjs tests/agent-infra/changed-scope.test.mjs tests/agent-infra/harness.test.mjs tests/agent-infra/rust-shards.test.mjs tests/agent-infra/rust-shared-target.test.mjs tests/agent-infra/rust-test-shards.test.mjs tests/agent-infra/rust-cache-key.test.mjs tests/agent-infra/vitest-legs.test.mjs tests/agent-infra/quality-gate.test.mjs tests/agent-infra/rustfmt-touched.test.mjs tests/agent-infra/supply-chain-gates.test.mjs tests/agent-infra/check-bundle-composition.test.mjs tests/agent-infra/self-review.test.mjs tests/agent-infra/release-macos.test.mjs tests/agent-infra/release-macos-cli.test.mjs tests/agent-infra/macos-installed-receipt.test.mjs tests/agent-infra/macos-candidate-audit.test.mjs tests/agent-infra/verify-updater-feed.test.mjs",
    "test:readme": "node --test tests/agent-infra/check-readme-drift.test.mjs",
    "test:docs": "node --test tests/agent-infra/check-docs.test.mjs tests/agent-infra/guard-documentation.test.mjs tests/agent-infra/release-notes.test.mjs tests/agent-infra/git2-ownership.test.mjs",
    "test:lint": "node --test tests/agent-infra/check-eslint-fixtures.test.mjs",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:ci": "vitest run tests/unit tests/integration && playwright test --reporter=line",
    "test:coverage": "vitest run --coverage",
    "bench:terminal-writer": "node --expose-gc scripts/bench-terminal-writer.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-global-shortcut": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^4.1.11"
  }
}
